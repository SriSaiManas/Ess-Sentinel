{
  "name": "ess-sentinel-web",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "dev": "vite client --config client/vite.config.js",
    "test": "node --test tests/*.test.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test:unit": "node --test tests/validation.test.js tests/frontend.test.js tests/demo_mode.test.js",
    "test:integration": "node --test tests/api.test.js",
    "test:python": "python -m pytest tests/",
    "test:all": "npm test && python -m pytest tests/"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^30.1.3",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  }
}