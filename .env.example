# ESS Sentinel Web 3.0 Environment Configuration
# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGO_DB=ess_sentinel

# Demonstration mode: true permits unauthenticated dashboard access for academic evaluation
DEMO_MODE=true

# Temporary processing directory (persistent artifacts are automatically stored in MongoDB GridFS)
ARTIFACT_DIR=/tmp/ess-sentinel-artifacts

# Python interpreter and timeouts
PYTHON_BIN=python
ML_TIMEOUT_MS=300000

# Web server configuration
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
